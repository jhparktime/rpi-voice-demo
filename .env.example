# Copy to .env and fill in your values. Do not commit .env (it is in .gitignore).

# --- Cloud LLM: use one of the following (priority: OpenAI > Gemini > CLOUD_LLM_URL) ---

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# CLOUD_LLM_MODEL=gemini-2.5-flash
